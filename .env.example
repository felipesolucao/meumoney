# ============================================================================
# Variáveis de ambiente — copie este arquivo para ".env" e preencha
# ============================================================================

# URL de conexão do banco PostgreSQL. No Railway, vá em:
#   Seu projeto > Plugin PostgreSQL > Aba "Variables" > copie "DATABASE_URL"
# (ou "DATABASE_PUBLIC_URL" se for rodar localmente fora da rede do Railway)
DATABASE_URL="postgresql://postgres:EVeNGmtTxtnnqGaSNsttCXssbkePpyXz@postgres.railway.internal:5432/railway"

# Chave usada para assinar o cookie de sessão do login. Gere uma aleatória
# (ex: rode "openssl rand -base64 32" no terminal) e cole aqui — e configure
# a MESMA variável no Railway (Variables do serviço do app, não do Postgres).
# Sem isso, o app usa uma chave padrão insegura (só serve pra testar local).
JWT_SECRET="troque-por-um-valor-aleatorio-longo"
