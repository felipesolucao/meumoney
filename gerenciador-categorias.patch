--- a/app/globals.css
+++ b/app/globals.css
@@ -328,6 +328,48 @@ h6 {
   white-space: nowrap;
 }
 
+/* Sheet (bottom sheet) que desliza de baixo pra cima — usado no seletor de
+   categorias e em outros modais que seguem o mesmo padrão visual. */
+@keyframes slideUp {
+  from {
+    transform: translateY(24px);
+    opacity: 0;
+  }
+  to {
+    transform: translateY(0);
+    opacity: 1;
+  }
+}
+
+/* Interruptor (toggle switch) — substitui o checkbox simples em opções do
+   tipo "já pago/recebido", mais fácil de ler/tocar num formulário mobile. */
+.switch {
+  width: 50px;
+  height: 30px;
+  border-radius: var(--radius-pill);
+  background: var(--color-muted-surface);
+  position: relative;
+  flex-shrink: 0;
+  transition: background 0.15s ease;
+}
+.switch[data-on="true"] {
